<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/styles.css">
    <title>Characters</title>
</head>

    <body>
        <%- include('partials/navbar') %>
        <h1>Characters Page</h1>

        <form method="POST" action="/characterSearch">
            <input type="text" name="name" placeholder="Search character by name">
            <button type="submit">Search</button>
        </form>

        <% if (isSearch) { %>
            <h2>Search Results for "<%= searchTerm %>"</h2>
        <% } %>

        <% if (typeof count !== 'undefined') { %>
            <h2>Total Characters: <%= count %></h2>
        <% } %>

        <% if (!isSearch && typeof currentPage !== 'undefined' && typeof pages !== 'undefined') { %>
            <h3>Page <%= currentPage %> of <%= pages %></h3>
        <% } %>

        <% if (characters.length === 0) { %>
            <p>No characters found.</p>
        <% } %>

        <% if (!isSearch) { %>
            <div>
                <% if (prevPage) { %>
                    <a href="/characters?page=<%= prevPage %>">Previous</a>
                <% } %>

                <% if (nextPage) { %>
                    <a href="/characters?page=<%= nextPage %>">Next</a>
                <% } %>
            </div>
        <% } %>

        <div>
            <% characters.forEach((character, index) => { %>
                <div>
                    <img src="<%= character.image %>" alt="<%= character.name %>">

                    <h3>
                        <% if (!isSearch) { %>
                            <%= (currentPage - 1) * 20 + index + 1 %>.
                        <% } else { %>
                            <%= index + 1 %>.
                        <% } %>
                        <%= character.name %>
                    </h3>

                    <p>Status: <%= character.status %></p>
                    <p>Species: <%= character.species %></p>
                    <p>Gender: <%= character.gender %></p>
                    <p>Origin: <%= character.origin.name %></p>
                    <p>Current Location: <%= character.location.name %></p>
                    <p>Number of Episodes: <%= character.episode.length %></p>
                </div>
                <hr>
            <% }) %>
        </div>

        <% if (!isSearch) { %>
            <div>
                <% if (prevPage) { %>
                    <a href="/characters?page=<%= prevPage %>">Previous</a>
                <% } %>

                <% if (nextPage) { %>
                    <a href="/characters?page=<%= nextPage %>">Next</a>
                <% } %>
            </div>
        <% } %>

        <%- include('partials/footer') %>
    </body>


